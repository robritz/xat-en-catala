# Base URL of the model host's OpenAI-compatible API.
# For RunPod: https://api.runpod.ai/v2/<endpoint id>/openai/v1
MODEL_HOST_URL=
MODEL_HOST_API_KEY=
CHAT_SECRET_PHRASE=
# Optional: only if the model host serves the model under another name.
MODEL_NAME=
# Optional: where the Matxa-TTS API that speaks replies is hosted.
# Defaults to http://localhost:8000.
TTS_API_URL=
