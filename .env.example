# Optional: the model that writes replies, salamandra or alia.
# Defaults to salamandra. Only the chosen model's host needs setting.
MODEL=
# Base URL of each model host's OpenAI-compatible API.
# For Cloud Run: the service's URL followed by /v1.
SALAMANDRA_HOST_URL=
SALAMANDRA_HOST_API_KEY=
ALIA_HOST_URL=
ALIA_HOST_API_KEY=
CHAT_SECRET_PHRASE=
# Optional: where the Matxa-TTS API that speaks replies is hosted.
# Defaults to http://localhost:8000.
TTS_API_URL=
